{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/src/generated/**",
    "**/.next/**",
    ".claude/**",
    ".hallmark/**",
    "tools/oxlint/anti-slop/**"
  ]
}
