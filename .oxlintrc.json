{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "import/no-cycle": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "dotenv/config"]
      }
    ]
  },
  "ignorePatterns": ["src/infrastructure/prisma/generated/**", ".next/**"],
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/application/*",
                  "@/infrastructure/*",
                  "@/app/*",
                  "next",
                  "next/*",
                  "react",
                  "@prisma/*"
                ],
                "message": "The domain is pure: it must not depend on outer layers or frameworks."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/application/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/infrastructure/*", "@/app/*", "next", "next/*", "react", "@prisma/*"],
                "message": "Use cases depend on the domain and ports only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
