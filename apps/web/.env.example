# Prisma Postgres connection string (Vercel injects it when the database is connected).
# Leave unset to run everything in memory.
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# Signs session cookies and JWTs. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public URL of the app (defaults to https://$VERCEL_URL on Vercel, http://localhost:3000 locally).
BETTER_AUTH_URL="http://localhost:3000"

# Telemetry (docs/telemetry.md). Optional: defaults to DATABASE_URL; prefer a pooled URL.
# TELEMETRY_DATABASE_URL=""
# Share of ordinary traces kept, 0..1 (errors and slow traces are always kept).
# TELEMETRY_SAMPLE_RATIO="1"
# Authorises the daily maintenance cron (Vercel sends it as a bearer token).
# CRON_SECRET=""
