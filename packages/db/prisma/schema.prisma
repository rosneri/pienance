generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Pie {
  id          String   @id
  /// ISO 4217 code, e.g. "EUR"
  currency    String
  /// In the currency's minor units (cents, yen, fils…)
  incomeMinor BigInt
  createdAt   DateTime @default(now())
  slices      Slice[]
}

model Slice {
  id       String @id
  pieId    String
  pie      Pie    @relation(fields: [pieId], references: [id], onDelete: Cascade)
  name     String
  /// Ratio of the pie, 0..1
  share    Float
  position Int
  bites    Bite[]

  @@index([pieId])
}

model Bite {
  id          String   @id
  sliceId     String
  slice       Slice    @relation(fields: [sliceId], references: [id], onDelete: Cascade)
  currency    String
  amountMinor BigInt
  note        String
  eatenAt     DateTime

  @@index([sliceId, eatenAt])
}
